{
  "name": "react-native-kata",
  "description": "An intentionally incomplete Expo service-booking exercise.",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "server": "tsc --project tsconfig-server.json && node dist/server/index.js",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --project tsconfig-server.json --noEmit"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "express": "^4.22.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
